<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CallLoggingSystem</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Syne:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="cls-navbar">
            <div class="cls-navbar-inner">
                <a class="cls-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="cls-brand-icon"><i class="bi bi-headset"></i></span>
                    <span class="cls-brand-text">CallLog</span>
                </a>

                <button class="cls-toggler" id="navToggler" aria-label="Toggle navigation">
                    <span></span><span></span><span></span>
                </button>

                <div class="cls-nav-links" id="navLinks">
                    @if (User.Identity.IsAuthenticated)
                    {
                        @if (User.HasClaim("IsStaff", "true"))
                        {
                            <a class="cls-nav-link" asp-controller="Staff" asp-action="Dashboard">
                                <i class="bi bi-grid-1x2"></i> Dashboard
                            </a>
                        }
                        @if (User.HasClaim("IsClient", "true"))
                        {
                            <a class="cls-nav-link" asp-controller="Client" asp-action="Dashboard">
                                <i class="bi bi-ticket-perforated"></i> My Tickets
                            </a>
                            <a class="cls-nav-link cls-nav-link--cta" asp-controller="Client" asp-action="Create">
                                <i class="bi bi-plus-lg"></i> New Ticket
                            </a>
                        }
                    }
                </div>

                <div class="cls-nav-right">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <div class="cls-user-pill">
                            <span class="cls-user-avatar">@User.Identity.Name?.Substring(0, 1).ToUpper()</span>
                            <span class="cls-user-name">@User.Identity.Name</span>
                        </div>
                        <a class="cls-btn-ghost" asp-controller="Home" asp-action="Logout">
                            <i class="bi bi-box-arrow-right"></i> Sign out
                        </a>
                    }
                    else if (ViewContext.RouteData.Values["controller"]?.ToString() != "Home" ||
                    ViewContext.RouteData.Values["action"]?.ToString() != "Index")
                    {
                        <a class="cls-btn-primary" asp-controller="Home" asp-action="Index">
                            Sign in <i class="bi bi-arrow-right"></i>
                        </a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="cls-main">
        @RenderBody()
    </main>

    <footer class="cls-footer">
        <div class="cls-footer-inner">
            <span class="cls-footer-brand"><i class="bi bi-headset"></i> CallLog</span>
            <span class="cls-footer-copy">&copy; @DateTime.Now.Year CallLoggingSystem. All rights reserved.</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        const toggler = document.getElementById('navToggler');
        const navLinks = document.getElementById('navLinks');
        if (toggler) {
            toggler.addEventListener('click', () => {
                navLinks.classList.toggle('open');
                toggler.classList.toggle('open');
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
